# datasets are re-downloaded on each server (MIGRATION/DATASETS.md)
/data_cache
/journal_expansion/data_cache/
# python / test caches
__pycache__/
*.pyc
.pytest_cache/
# local agent state
/.claude/
# live queue state (per server, recreated by the workers)
journal_expansion/runs/queue*/queue.lock
journal_expansion/runs/queue*/running_heavy*/
journal_expansion/runs/queue*/STOP
# mobility traces for Round 6 S2 (re-downloaded, not committed; see artifacts/driftgate_tmc_r6)
/data/traces
journal_expansion/runs/queue*/running_gpu*/
journal_expansion/runs/phaseT8_check/*_requests.npz
journal_expansion/runs/phaseT10_prior/*_evalprobs.npz
# Round 12 per-request records (~13 GB, kept on the server; sha256 in artifacts/driftgate_tmc_r12_fusion_eval) and saved models
journal_expansion/runs/phaseT12_fusion/*_evalprobs.npz
journal_expansion/runs/phaseT12_fusion/*_final_models.pt
# Round 13b per-request records (kept on the server; sha256 in artifacts/driftgate_tmc_r13b_baselines) and analysis cache
journal_expansion/runs/phaseT13b_arch/*_evalprobs.npz
journal_expansion/artifacts/driftgate_tmc_r13b_baselines/cache/
# Round 14 per-run analysis cache
journal_expansion/artifacts/driftgate_tmc_r14_paper/cache/
# Round 15 per-request records and end-of-day checkpoints (kept on the server)
journal_expansion/runs/phaseT15_replay/*_evalprobs.npz
journal_expansion/runs/phaseT15_replay/*_ckpt.pt
journal_expansion/artifacts/driftgate_tmc_r15_revision/cache/
# Round 16 per-run caches (reference answers and stage-1 summaries)
journal_expansion/artifacts/driftgate_tmc_r16_selector/cache/
# Round 17 replay records with features (kept on the server)
journal_expansion/runs/phaseT17_featgate/*_evalprobs.npz
journal_expansion/runs/phaseT17_featgate/*_features.npz
journal_expansion/runs/phaseT17_featgate/*_own.npz
journal_expansion/artifacts/driftgate_tmc_r17_featgate/cache/
# Round 18 per-run caches
journal_expansion/artifacts/driftgate_tmc_r18_compare/cache/
# Round 19 per-run caches
journal_expansion/artifacts/driftgate_tmc_r19_weights/cache/
journal_expansion/artifacts/driftgate_tmc_r20_claims/cache/
# Round 19 multi-day replay records (kept on the server)
journal_expansion/runs/phaseT19_multiday/*_evalprobs.npz
